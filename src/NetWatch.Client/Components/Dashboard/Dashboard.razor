@page "/"
@inject HttpClient _http
@inject DashboardState State
@using NetWatch.Core.Live
@using NetWatch.Core.Usage

<PageTitle>Dashboard — NetWatch</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Historical overview</p>
        <h1>Dashboard</h1>
        <p>Network usage captured from your MikroTik router.</p>
    </div>
</div>

@if (State.Loading)
{
    <div class="skeleton-grid" aria-label="Loading dashboard">
        @for (var index = 0; index < 4; index++)
        {
            <span></span>
        }
    </div>
}
else if (State.Error is not null)
{
    <section class="state-panel error-state" role="alert">
        <span class="state-icon"><AppIcon Name="alert" /></span>
        <div><strong>Dashboard data is unavailable</strong><p>@State.Error</p></div>
        <button class="secondary-button" @onclick="LoadAsync">Try again</button>
    </section>
}
else if (State.Summary is not null)
{
    <div class="period-tabs" aria-label="Usage period">
        <button class="@TodayPeriodClass" @onclick="SelectTodayAsync">Today</button>
        <button class="@WeekPeriodClass" @onclick="SelectWeekAsync">This week</button>
        <button class="@MonthPeriodClass" @onclick="SelectMonthAsync">This month</button>
    </div>

    <section class="stat-grid" aria-label="Network totals">
        <UsageStatCard Label="Total download" PrimaryBytes="@State.SelectedPeriod.Totals.DownloadBytes"
                       Detail="@($"{Helpers.Number(State.SelectedPeriod.Totals.DownloadPackets)} packets")" Icon="download" />
        <UsageStatCard Label="Total upload" PrimaryBytes="@State.SelectedPeriod.Totals.UploadBytes"
                       Detail="@($"{Helpers.Number(State.SelectedPeriod.Totals.UploadPackets)} packets")" Icon="upload" AccentClass="accent-violet" />
        <UsageStatCard Label="Total traffic" PrimaryBytes="@(State.SelectedPeriod.Totals.DownloadBytes + State.SelectedPeriod.Totals.UploadBytes)"
                       Detail="@State.PeriodLabel" Icon="activity" AccentClass="accent-green" />
        <UsageStatCard Label="Current speed" Value="@Helpers.BitsPerSecond(State.CurrentNetworkSpeed)"
                       Detail="@State.CurrentNetworkSpeedDetail" Icon="online" AccentClass="accent-amber" />
    </section>

    <div class="dashboard-grid">
        <section class="panel chart-panel">
            <div class="panel-heading">
                <div><p class="eyebrow">Network-wide</p><h2>Internet usage</h2></div>
                <span>@State.ChartCaption</span>
            </div>
            @if (State.PeriodLoading)
            {
                <div class="chart-loading">Loading usage…</div>
            }
            else
            {
                <UsageBarChart Points="@(State.History?.Points ?? [])" />
            }
        </section>

        <section class="panel ranking-panel">
            <div class="panel-heading">
                <div><p class="eyebrow">Ranked by traffic</p><h2>Top devices</h2></div>
                <a href="devices">View all</a>
            </div>
            @if (State.DeviceUsage.Count == 0)
            {
                <div class="compact-empty">No device usage for this period.</div>
            }
            else
            {
                <ol class="ranking-list">
                    @for (var index = 0; index < Math.Min(6, State.DeviceUsage.Count); index++)
                    {
                        var device = State.DeviceUsage[index];
                        var total = device.Totals.DownloadBytes + device.Totals.UploadBytes;
                        <li>
                            <span class="rank">@(State.DeviceUsage.IndexOf(device) + 1)</span>
                            <div><a href="@($"devices/{device.DeviceId}")">@device.DisplayName</a><span>@State.Share(total)</span></div>
                            <strong>@Helpers.Bytes(total)</strong>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

    <section class="panel device-table-panel">
        <div class="panel-heading">
            <div><p class="eyebrow">Historical totals</p><h2>Device usage</h2></div>
            <a class="secondary-button" href="devices">Manage devices</a>
        </div>
        @if (State.DeviceUsage.Count == 0)
        {
            <div class="compact-empty">Devices will appear after discovery and the first usage flush.</div>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead><tr><th>Device</th><th>MAC address</th><th>Current speed</th><th>Download</th><th>Upload</th><th>Total</th><th>Share</th></tr></thead>
                    <tbody>
                        @foreach (var device in State.DeviceUsage)
                        {
                            var total = device.Totals.DownloadBytes + device.Totals.UploadBytes;
                            <tr>
                                <td><a href="@($"devices/{device.DeviceId}")">@device.DisplayName</a></td>
                                <td class="mac-address selectable-text">@(device.MacAddress ?? "—")</td>
                                <td>@Helpers.BitsPerSecond(State.CurrentSpeed(device.DeviceId))</td>
                                <td class="download-value">@Helpers.Bytes(device.Totals.DownloadBytes)</td>
                                <td class="upload-value">@Helpers.Bytes(device.Totals.UploadBytes)</td>
                                <td>@Helpers.Bytes(total)</td>
                                <td>@State.Share(total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private readonly PeriodicTimer _refreshTimer = new(TimeSpan.FromSeconds(2));
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _loadLock = new(1, 1);
    private Task? _refreshTask;

    private string TodayPeriodClass => State.PeriodClass("today");
    private string WeekPeriodClass => State.PeriodClass("week");
    private string MonthPeriodClass => State.PeriodClass("month");

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _refreshTask = RefreshLoopAsync();
    }

    private async Task LoadAsync()
    {
        await _loadLock.WaitAsync();
        try
        {
            await LoadDashboardAsync(showLoading: true);
        }
        finally
        {
            _loadLock.Release();
        }
    }

    private async Task LoadDashboardAsync(bool showLoading)
    {
        if (showLoading)
        {
            State.Loading = true;
        }

        State.Error = null;
        try
        {
            State.Summary = await _http.GetFromJsonAsync<UsageSummaryResponse>("api/usage/summary", _lifetimeCancellation.Token);
            if (State.Summary is null)
            {
                State.Error = "The usage service returned no data.";
                return;
            }

            await LoadPeriodAsync(showLoading);
        }
        catch (HttpRequestException)
        {
            State.Error = "NetWatch could not reach the historical usage service. Check the collector status and try again.";
        }
        finally
        {
            if (showLoading)
            {
                State.Loading = false;
            }
        }
    }

    private async Task SelectPeriodAsync(string period)
    {
        if (State.SelectedPeriodKey == period || State.Summary is null)
        {
            return;
        }

        await _loadLock.WaitAsync();
        try
        {
            State.SelectedPeriodKey = period;
            await LoadPeriodAsync(showLoading: true);
        }
        finally
        {
            _loadLock.Release();
        }
    }

    private Task SelectTodayAsync() => SelectPeriodAsync("today");
    private Task SelectWeekAsync() => SelectPeriodAsync("week");
    private Task SelectMonthAsync() => SelectPeriodAsync("month");

    private async Task LoadPeriodAsync(bool showLoading)
    {
        if (showLoading)
        {
            State.PeriodLoading = true;
        }

        try
        {
            var range = State.SelectedPeriod;
            var from = Uri.EscapeDataString(range.FromUtc.ToString("O"));
            var to = Uri.EscapeDataString(range.ToUtc.ToString("O"));
            var grouping = State.Grouping;
            var historyTask = _http.GetFromJsonAsync<UsageHistoryResponse>(
                $"api/usage/history?from={from}&to={to}&grouping={grouping}",
                _lifetimeCancellation.Token);
            var devicesTask = _http.GetFromJsonAsync<List<DeviceUsageResponse>>(
                $"api/usage/devices?from={from}&to={to}",
                _lifetimeCancellation.Token);
            var liveTrafficTask = _http.GetFromJsonAsync<LiveTrafficSnapshotResponse>("api/live", _lifetimeCancellation.Token);
            await Task.WhenAll(historyTask, devicesTask, liveTrafficTask);
            var history = await historyTask;
            var deviceUsage = await devicesTask ?? [];
            var liveTraffic = await liveTrafficTask;
            Reactive.Batch(() =>
            {
                State.History = history;
                State.DeviceUsage.ReplaceAll(deviceUsage);
                State.LiveTraffic = liveTraffic;
            });
        }
        catch (HttpRequestException)
        {
            State.Error = "Usage for the selected period could not be loaded.";
        }
        finally
        {
            if (showLoading)
            {
                State.PeriodLoading = false;
            }
        }
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(_lifetimeCancellation.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (!await _loadLock.WaitAsync(0))
        {
            return;
        }

        try
        {
            // A background refresh shows its result in one render, never the cleared error or a half-loaded period.
            await Reactive.BatchAsync(() => LoadDashboardAsync(showLoading: false));
        }
        finally
        {
            _loadLock.Release();
        }
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        await _lifetimeCancellation.CancelAsync();
        _refreshTimer.Dispose();

        if (_refreshTask is not null)
        {
            await _refreshTask;
        }

        // The source and the lock are not disposed: a cancelled load can still be unwinding and release the lock.
        // Neither owns a timer or wait handle, so there is nothing to free.

        await base.DisposeAsyncCore();
    }

}
