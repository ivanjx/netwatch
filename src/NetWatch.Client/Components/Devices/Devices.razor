@page "/devices"
@inject HttpClient _http
@inject Microsoft.JSInterop.IJSRuntime _js
@inject DevicesState State
@using System.Net
@using System.Net.Http.Json
@using NetWatch.Core.Devices

<PageTitle>Devices — NetWatch</PageTitle>

<div class="page-heading">
    <div><p class="eyebrow">Inventory</p><h1>Devices</h1></div>
    <div class="page-actions">
        <p>DHCP clients discovered from RouterOS and devices you add manually.</p>
        <button class="danger-button" disabled="@State.ClearingUsage" @onclick="ClearAllUsageAsync">
            @(State.ClearingUsage ? "Clearing…" : "Clear all usage history")
        </button>
    </div>
</div>

@if (State.Error is not null)
{
    <p class="error-message" role="alert">@State.Error</p>
}

@if (State.Message is not null)
{
    <p class="success-message" role="status">@State.Message</p>
}

<section class="manual-device">
    <h2>Add a manual device</h2>
    <div class="form-grid">
        <label>Name <input @bind="State.ManualName" maxlength="100" /></label>
        <label>IP address or subnet <input @bind="State.ManualAddress" placeholder="192.168.88.10 or 192.168.90.0/24" /></label>
        <label>MAC address <input @bind="State.ManualMac" placeholder="AA:BB:CC:DD:EE:FF" /></label>
        <label>Type <input @bind="State.ManualType" maxlength="50" /></label>
        <label class="notes">Notes <textarea @bind="State.ManualNotes" maxlength="2000"></textarea></label>
    </div>
    <button class="primary-button" disabled="@State.Saving" @onclick="CreateManualAsync">Add device</button>
</section>

@if (!State.IsLoaded)
{
    <p>Loading devices…</p>
}
else if (State.Devices.Count == 0)
{
    <p class="empty-state">No devices yet. Active DHCP leases will appear after the next router synchronization.</p>
}
else
{
    <div class="device-list">
        @foreach (var device in State.Devices)
        {
            <article class="device-card" @key="device.Id">
                <div>
                    @if (State.EditingId == device.Id)
                    {
                        <input aria-label="Friendly name" @bind="State.EditName" maxlength="100" />
                        <button disabled="@State.Saving" @onclick="() => RenameAsync(device.Id)">Save</button>
                        <button disabled="@State.Saving" @onclick="CancelRename">Cancel</button>
                    }
                    else
                    {
                        <h2><a href="@($"devices/{device.Id}")">@device.DisplayName</a></h2>
                        <button class="link-button" @onclick="() => BeginRename(device)">Rename</button>
                    }
                    <p class="selectable-text">@(device.CurrentIpAddress ?? "No current IP") · @(device.MacAddress ?? "No MAC") · @device.Type</p>
                </div>
                <div class="device-state">
                    <span class="@DeviceStatusClass(device)">@DeviceStatusLabel(device)</span>
                    <span>@(device.IsManual ? "Manual" : "DHCP")</span>
                    <a class="usage-link" href="@($"devices/{device.Id}")">Usage history<AppIcon Name="arrow-right" /></a>
                </div>
            </article>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var devices = await _http.GetFromJsonAsync<List<DeviceSummaryResponse>>("api/devices") ?? [];
            Reactive.Batch(() =>
            {
                State.Devices.ReplaceAll(devices);
                State.IsLoaded = true;
                State.Error = null;
            });
        }
        catch (HttpRequestException)
        {
            State.Error = "Device data could not be loaded.";
        }
    }

    private void BeginRename(DeviceSummaryResponse device)
    {
        Reactive.Batch(() =>
        {
            State.EditingId = device.Id;
            State.EditName = device.FriendlyName ?? device.DisplayName;
        });
    }

    private void CancelRename()
    {
        Reactive.Batch(() =>
        {
            State.EditingId = null;
            State.EditName = null;
        });
    }

    private async Task RenameAsync(string id)
    {
        if (State.EditName?.Trim().Length > 100)
        {
            State.Error = "Friendly names cannot exceed 100 characters.";
            return;
        }

        State.Saving = true;
        State.Error = null;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Patch, $"api/devices/{id}")
            {
                Content = JsonContent.Create(new RenameDeviceRequest(State.EditName))
            };
            using var response = await _http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                State.Error = "The friendly name could not be saved.";
                return;
            }

            CancelRename();
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            State.Error = "The friendly name could not be saved.";
        }
        finally
        {
            State.Saving = false;
        }
    }

    private async Task CreateManualAsync()
    {
        if (!ValidateManualDevice())
        {
            return;
        }

        State.Saving = true;
        State.Error = null;
        try
        {
            using var response = await _http.PostAsJsonAsync(
                "api/devices/manual",
                new CreateManualDeviceRequest(State.ManualName, State.ManualAddress, State.ManualMac, State.ManualType, State.ManualNotes));
            if (!response.IsSuccessStatusCode)
            {
                State.Error = "Check the manual device values and try again.";
                return;
            }

            Reactive.Batch(() =>
            {
                State.ManualName = string.Empty;
                State.ManualAddress = string.Empty;
                State.ManualMac = string.Empty;
                State.ManualType = "Client";
                State.ManualNotes = string.Empty;
            });
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            State.Error = "The manual device could not be saved. Check the server status and try again.";
        }
        finally
        {
            State.Saving = false;
        }
    }

    private async Task ClearAllUsageAsync()
    {
        var confirmed = await _js.InvokeAsync<bool>(
            "confirm",
            ["Clear all usage history for every device? This cannot be undone."]);
        if (!confirmed)
        {
            return;
        }

        State.ClearingUsage = true;
        State.Error = null;
        State.Message = null;
        try
        {
            using var response = await _http.DeleteAsync("api/usage");
            if (!response.IsSuccessStatusCode)
            {
                State.Error = "Usage history could not be cleared.";
                return;
            }

            State.Message = "Usage history was cleared for all devices.";
        }
        catch (HttpRequestException)
        {
            State.Error = "Usage history could not be cleared.";
        }
        finally
        {
            State.ClearingUsage = false;
        }
    }

    private bool ValidateManualDevice()
    {
        var name = State.ManualName.Trim();
        if (name.Length is 0 or > 100)
        {
            State.Error = "A name of at most 100 characters is required.";
            return false;
        }

        var address = State.ManualAddress.Trim();
        if (address.Length > 0 &&
            !IPAddress.TryParse(address, out _) &&
            !IPNetwork.TryParse(address, out _))
        {
            State.Error = "Enter a valid IP address or subnet.";
            return false;
        }

        if (!IsValidMacAddress(State.ManualMac))
        {
            State.Error = "Enter a valid MAC address.";
            return false;
        }

        if (State.ManualType.Trim().Length > 50)
        {
            State.Error = "Device types cannot exceed 50 characters.";
            return false;
        }

        if (State.ManualNotes.Length > 2_000)
        {
            State.Error = "Notes cannot exceed 2,000 characters.";
            return false;
        }

        State.Error = null;
        return true;
    }

    private static bool IsValidMacAddress(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        var hexDigitCount = 0;
        foreach (var character in value)
        {
            if (Uri.IsHexDigit(character))
            {
                hexDigitCount++;
            }
            else if (character is not ':' and not '-' and not '.')
            {
                return false;
            }
        }

        return hexDigitCount == 12;
    }

    private static string DeviceStatusClass(DeviceSummaryResponse device) => device switch
    {
        { IsManual: true } => "static",
        { IsOnline: true } => "online",
        _ => "offline"
    };

    private static string DeviceStatusLabel(DeviceSummaryResponse device) => device switch
    {
        { IsManual: true } => "Static",
        { IsOnline: true } => "Online",
        _ => "Offline"
    };
}
