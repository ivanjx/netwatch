@page "/devices/{Id}"
@inject HttpClient _http
@inject Microsoft.JSInterop.IJSRuntime _js
@inject DeviceDetailsState State
@using NetWatch.Core.Diagnostics
@using NetWatch.Core.Devices
@using NetWatch.Core.Live
@using NetWatch.Core.Usage

<PageTitle>@(State.Device?.DisplayName ?? "Device") — NetWatch</PageTitle>

@if (State.Loading)
{
    <div class="detail-loading" aria-label="Loading device details"><span></span><span></span><span></span></div>
}
else if (State.Error is not null)
{
    <section class="detail-state" role="alert">
        <strong>Device details are unavailable</strong>
        <p>@State.Error</p>
        <a class="secondary-button" href="devices">Back to devices</a>
    </section>
}
else if (State.Device is not null)
{
    <div class="page-heading">
        <div>
            <a class="back-link" href="devices"><AppIcon Name="arrow-left" />Devices</a>
            <h1>@State.Device.DisplayName</h1>
            <p>@(State.Device.DiscoveredName ?? "Manually managed device")</p>
        </div>
        <div class="heading-actions">
            <span class="status-pill @State.DeviceStatusClass">
                <AppIcon Name="status" />@State.DeviceStatusLabel
            </span>
            <button class="danger-button" disabled="@State.ClearingUsage" @onclick="ClearUsageAsync">
                @(State.ClearingUsage ? "Clearing…" : "Clear usage history")
            </button>
        </div>
    </div>

    @if (State.UsageError is not null)
    {
        <p class="range-error" role="alert">@State.UsageError</p>
    }

    <section class="stat-grid" aria-label="Device period totals">
        <UsageStatCard Label="Today" PrimaryBytes="@Total(State.Today)" Detail="@Split(State.Today)" Icon="activity" />
        <UsageStatCard Label="This week" PrimaryBytes="@Total(State.Week)" Detail="@Split(State.Week)" Icon="activity" AccentClass="accent-violet" />
        <UsageStatCard Label="This month" PrimaryBytes="@Total(State.Month)" Detail="@Split(State.Month)" Icon="activity" AccentClass="accent-green" />
        <UsageStatCard Label="Current speed" Value="@Helpers.BitsPerSecond(State.CurrentSpeed)" Detail="@State.CurrentSpeedDetail" Icon="online" AccentClass="accent-amber" />
    </section>

    <div class="detail-grid">
        <section class="panel history-panel">
            <div class="panel-heading history-heading">
                <div><p class="eyebrow">Selected range</p><h2>Usage history</h2></div>
                <div class="date-range">
                    <label>From<input type="date" @bind="State.FromDate" /></label>
                    <label>Through<input type="date" @bind="State.ToDate" /></label>
                    <button class="secondary-button" disabled="@State.HistoryLoading" @onclick="LoadHistoryAsync">Apply</button>
                </div>
            </div>
            @if (State.RangeError is not null)
            {
                <p class="range-error" role="alert">@State.RangeError</p>
            }
            else if (State.HistoryLoading)
            {
                <div class="history-loading">Loading history…</div>
            }
            else
            {
                <UsageBarChart Points="@(State.History?.Points ?? [])" />
                <div class="range-total">
                    <span>Range total</span>
                    <strong>@Helpers.Bytes(State.HistoryTotal)</strong>
                </div>
            }
        </section>

        <aside class="panel identity-panel">
            <div class="panel-heading"><div><p class="eyebrow">Identity</p><h2>Device information</h2></div></div>
            <dl>
                <div><dt>Current IP</dt><dd class="selectable-text">@(State.Device.CurrentIpAddress ?? "Not assigned")</dd></div>
                <div><dt>MAC address</dt><dd class="selectable-text">@(State.Device.MacAddress ?? "Not recorded")</dd></div>
                <div><dt>Type</dt><dd>@State.Device.Type</dd></div>
                <div><dt>Source</dt><dd>@(State.Device.IsManual ? "Manual" : "DHCP")</dd></div>
                <div><dt>Last seen</dt><dd>@(State.Device.LastSeen ?? "Not reported")</dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(State.Device.Notes))
            {
                <div class="notes"><span>Notes</span><p class="selectable-text">@State.Device.Notes</p></div>
            }
        </aside>
    </div>

    <section class="panel assignments-panel">
        <div class="panel-heading"><div><p class="eyebrow">Address history</p><h2>IP assignments</h2></div></div>
        @if (State.Device.IpAssignments.Count == 0)
        {
            <p class="empty-copy">No IP assignments have been recorded.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead><tr><th>IP address</th><th>Source</th><th>Assigned</th><th>Ended</th></tr></thead>
                    <tbody>
                        @foreach (var assignment in State.Device.IpAssignments)
                        {
                            <tr>
                                <td class="selectable-text"><code>@assignment.IpAddress</code></td>
                                <td>@assignment.Source</td>
                                <td>@assignment.ValidFromDisplay</td>
                                <td>@(assignment.ValidToDisplay ?? "Current")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private readonly PeriodicTimer _refreshTimer = new(TimeSpan.FromSeconds(2));
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _loadLock = new(1, 1);
    private Task? _refreshTask;

    protected override async Task OnParametersSetAsync()
    {
        await _loadLock.WaitAsync();
        try
        {
            await LoadDeviceAsync(showLoading: true, resetRange: true);
        }
        finally
        {
            _loadLock.Release();
        }

        _refreshTask ??= RefreshLoopAsync();
    }

    private async Task LoadDeviceAsync(bool showLoading, bool resetRange)
    {
        Reactive.Batch(() =>
        {
            if (showLoading)
            {
                State.Loading = true;
            }

            State.Error = null;
        });

        try
        {
            var cancellationToken = _lifetimeCancellation.Token;
            var deviceTask = _http.GetFromJsonAsync<DeviceDetailsResponse>($"api/devices/{Uri.EscapeDataString(Id)}", cancellationToken);
            var summaryTask = _http.GetFromJsonAsync<UsageSummaryResponse>("api/usage/summary", cancellationToken);
            var statusTask = _http.GetFromJsonAsync<SystemStatusResponse>("api/status", cancellationToken);
            var liveTrafficTask = _http.GetFromJsonAsync<LiveTrafficSnapshotResponse>("api/live", cancellationToken);
            await Task.WhenAll(deviceTask, summaryTask, statusTask, liveTrafficTask);
            var device = await deviceTask;
            var summary = await summaryTask;
            var status = await statusTask;
            var liveTraffic = await liveTrafficTask;
            if (device is null || summary is null || status is null)
            {
                Reactive.Batch(() =>
                {
                    State.Device = device;
                    State.Summary = summary;
                    State.Status = status;
                    State.LiveTraffic = liveTraffic?.Devices.FirstOrDefault(entry => entry.DeviceId == Id)?.Rate;
                    State.Error = "NetWatch returned an incomplete device record.";
                });
                return;
            }

            Reactive.Batch(() =>
            {
                State.Device = device;
                State.Summary = summary;
                State.Status = status;
                State.LiveTraffic = liveTraffic?.Devices.FirstOrDefault(entry => entry.DeviceId == Id)?.Rate;
                if (resetRange)
                {
                    var reportingToday = status.CurrentTime.Date;
                    State.FromDate = new DateTime(reportingToday.Year, reportingToday.Month, 1);
                    State.ToDate = reportingToday;
                }
            });

            await LoadTotalsAsync(summary);
            await LoadHistoryAsync(showLoading);
        }
        catch (HttpRequestException exception)
        {
            State.Error = exception.StatusCode == System.Net.HttpStatusCode.NotFound ?
                "This device does not exist or has been archived." :
                "NetWatch could not load this device. Try again after checking the server status.";
        }
        finally
        {
            if (showLoading)
            {
                State.Loading = false;
            }
        }
    }

    private async Task LoadTotalsAsync(UsageSummaryResponse summary)
    {
        var todayTask = LoadDeviceTotalsAsync(summary.Today);
        var weekTask = LoadDeviceTotalsAsync(summary.Week);
        var monthTask = LoadDeviceTotalsAsync(summary.Month);
        await Task.WhenAll(todayTask, weekTask, monthTask);
        var today = await todayTask;
        var week = await weekTask;
        var month = await monthTask;
        Reactive.Batch(() =>
        {
            State.Today = today;
            State.Week = week;
            State.Month = month;
        });
    }

    private async Task<UsageTotalsResponse> LoadDeviceTotalsAsync(UsagePeriodResponse period)
    {
        var from = Uri.EscapeDataString(period.FromUtc.ToString("O"));
        var to = Uri.EscapeDataString(period.ToUtc.ToString("O"));
        var devices = await _http.GetFromJsonAsync<List<DeviceUsageResponse>>(
            $"api/usage/devices?from={from}&to={to}",
            _lifetimeCancellation.Token) ?? [];
        return devices.FirstOrDefault(device => device.DeviceId == Id)?.Totals ?? DeviceDetailsState.EmptyTotals;
    }

    private Task LoadHistoryAsync() => LoadHistoryAsync(showLoading: true);

    private async Task LoadHistoryAsync(bool showLoading)
    {
        var fromDate = State.FromDate;
        var toDate = State.ToDate;
        if (fromDate > toDate)
        {
            State.RangeError = "Choose a valid range with the start on or before the end.";
            return;
        }

        var dayCount = (toDate.Date - fromDate.Date).Days + 1;
        if (dayCount > 370)
        {
            State.RangeError = "Choose a date range of 370 days or fewer.";
            return;
        }

        Reactive.Batch(() =>
        {
            State.RangeError = null;
            if (showLoading)
            {
                State.HistoryLoading = true;
            }
        });

        try
        {
            var from = fromDate.ToString("yyyy-MM-dd");
            var toExclusive = toDate.AddDays(1).ToString("yyyy-MM-dd");
            var grouping = dayCount > 90 ? "month" : "day";
            State.History = await _http.GetFromJsonAsync<UsageHistoryResponse>(
                $"api/usage/history?from={from}&to={toExclusive}&grouping={grouping}&deviceId={Uri.EscapeDataString(Id)}",
                _lifetimeCancellation.Token);
        }
        catch (HttpRequestException)
        {
            State.RangeError = "Usage history could not be loaded for that range.";
        }
        finally
        {
            if (showLoading)
            {
                State.HistoryLoading = false;
            }
        }
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(_lifetimeCancellation.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (!await _loadLock.WaitAsync(0))
        {
            return;
        }

        try
        {
            // A background refresh shows its result in one render, never the cleared error or a half-loaded record.
            await Reactive.BatchAsync(() => LoadDeviceAsync(showLoading: false, resetRange: false));
        }
        finally
        {
            _loadLock.Release();
        }
    }

    private async Task ClearUsageAsync()
    {
        var confirmed = await _js.InvokeAsync<bool>(
            "confirm",
            [$"Clear all usage history for {State.Device!.DisplayName}? This cannot be undone."]);
        if (!confirmed)
        {
            return;
        }

        // Hold the load lock so a refresh that started before the delete cannot write the old totals afterwards.
        await _loadLock.WaitAsync(_lifetimeCancellation.Token);
        try
        {
            Reactive.Batch(() =>
            {
                State.ClearingUsage = true;
                State.UsageError = null;
            });

            using var response = await _http.DeleteAsync(
                $"api/usage/devices/{Uri.EscapeDataString(Id)}",
                _lifetimeCancellation.Token);
            if (!response.IsSuccessStatusCode)
            {
                State.UsageError = "Usage history could not be cleared.";
                return;
            }

            await LoadTotalsAsync(State.Summary!);
            await LoadHistoryAsync();
        }
        catch (HttpRequestException)
        {
            State.UsageError = "Usage history could not be cleared.";
        }
        finally
        {
            State.ClearingUsage = false;
            _loadLock.Release();
        }
    }

    private static long Total(UsageTotalsResponse totals) => totals.DownloadBytes + totals.UploadBytes;

    private static string Split(UsageTotalsResponse totals) =>
        $"{Helpers.Bytes(totals.DownloadBytes)} down · {Helpers.Bytes(totals.UploadBytes)} up";

    protected override async ValueTask DisposeAsyncCore()
    {
        await _lifetimeCancellation.CancelAsync();
        _refreshTimer.Dispose();

        if (_refreshTask is not null)
        {
            await _refreshTask;
        }

        // The source and the lock are not disposed: a cancelled load can still be unwinding and release the lock.
        // Neither owns a timer or wait handle, so there is nothing to free.

        await base.DisposeAsyncCore();
    }
}
